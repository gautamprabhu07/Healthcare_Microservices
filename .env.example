# Copy this file to .env and fill in real values. .env is gitignored.
# Generate the secret with: openssl rand -base64 32
JWT_SECRET=<generate-with: openssl rand -base64 32>
# Optional: JWT lifetime in milliseconds (default 8 hours)
# JWT_EXPIRATION_MS=28800000
# Optional: comma-separated browser origins allowed by the gateway (CORS)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional: clinic time zone for appointment hours (09:00-17:00, Mon-Fri). Default UTC.
# CLINIC_TIMEZONE=Asia/Kolkata
# Optional: fee billed automatically when an appointment is completed. Default 50.00.
# CONSULTATION_FEE=50.00
